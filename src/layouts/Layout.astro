---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description = 'ExcelyDatos — Aprende Excel, Power BI y SQL desde cero con guías prácticas y directas al punto.',
  canonical = Astro.url.href,
  ogImage = '/og-default.png',
} = Astro.props;

const siteName = 'ExcelyDatos';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="bg-[#F8FAFC] text-[#1E293B] font-inter antialiased">
    <!-- Header / Navigation -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Logo -->
          <a href="/" class="flex items-center gap-2 group">
            <div class="w-8 h-8 bg-emerald-700 rounded-md flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="1" y="1" width="7" height="7" rx="1" fill="white" opacity="0.9"/>
                <rect x="10" y="1" width="7" height="7" rx="1" fill="white" opacity="0.5"/>
                <rect x="1" y="10" width="7" height="7" rx="1" fill="white" opacity="0.5"/>
                <rect x="10" y="10" width="7" height="7" rx="1" fill="white" opacity="0.9"/>
              </svg>
            </div>
            <span class="text-lg font-bold text-[#1E293B] tracking-tight">
              Excely<span class="text-emerald-700">Datos</span>
            </span>
          </a>

          <!-- Desktop Nav -->
          <nav class="hidden md:flex items-center gap-1">
            <a
              href="/excel/"
              class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 transition-colors duration-150"
            >
              Excel & Sheets
            </a>
            <a
              href="/powerbi/"
              class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:text-amber-700 hover:bg-amber-50 transition-colors duration-150"
            >
              Power BI
            </a>
            <a
              href="/sql/"
              class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:text-sky-700 hover:bg-sky-50 transition-colors duration-150"
            >
              SQL
            </a>
          </nav>

          <!-- Mobile menu button -->
          <button
            id="mobile-menu-btn"
            class="md:hidden p-2 rounded-md text-slate-500 hover:text-slate-700 hover:bg-slate-100 transition-colors"
            aria-label="Abrir menú"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
        </div>

        <!-- Mobile Nav -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 py-3 space-y-1">
          <a href="/excel/" class="block px-3 py-2 rounded-md text-sm font-medium text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">Excel & Google Sheets</a>
          <a href="/powerbi/" class="block px-3 py-2 rounded-md text-sm font-medium text-slate-700 hover:bg-amber-50 hover:text-amber-700 transition-colors">Power BI</a>
          <a href="/sql/" class="block px-3 py-2 rounded-md text-sm font-medium text-slate-700 hover:bg-sky-50 hover:text-sky-700 transition-colors">SQL</a>
        </div>
      </div>
    </header>

    <!-- Main content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-[#1E293B] text-slate-400 mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- Brand -->
          <div class="md:col-span-1">
            <div class="flex items-center gap-2 mb-4">
              <div class="w-7 h-7 bg-emerald-600 rounded-md flex items-center justify-center">
                <svg width="15" height="15" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="1" y="1" width="7" height="7" rx="1" fill="white" opacity="0.9"/>
                  <rect x="10" y="1" width="7" height="7" rx="1" fill="white" opacity="0.5"/>
                  <rect x="1" y="10" width="7" height="7" rx="1" fill="white" opacity="0.5"/>
                  <rect x="10" y="10" width="7" height="7" rx="1" fill="white" opacity="0.9"/>
                </svg>
              </div>
              <span class="text-white font-bold">Excely<span class="text-emerald-400">Datos</span></span>
            </div>
            <p class="text-sm leading-relaxed">
              Guías prácticas de Excel, Power BI y SQL para profesionales que quieren trabajar mejor con sus datos.
            </p>
          </div>

          <!-- Categorías -->
          <div>
            <h3 class="text-white text-sm font-semibold mb-4 uppercase tracking-wider">Categorías</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/excel/" class="hover:text-emerald-400 transition-colors">Excel & Google Sheets</a></li>
              <li><a href="/powerbi/" class="hover:text-amber-400 transition-colors">Power BI</a></li>
              <li><a href="/sql/" class="hover:text-sky-400 transition-colors">SQL</a></li>
            </ul>
          </div>

          <!-- Legal -->
          <div>
            <h3 class="text-white text-sm font-semibold mb-4 uppercase tracking-wider">Legal</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/privacidad/" class="hover:text-white transition-colors">Política de Privacidad</a></li>
              <li><a href="/cookies/" class="hover:text-white transition-colors">Política de Cookies</a></li>
              <li><a href="/aviso-legal/" class="hover:text-white transition-colors">Aviso Legal</a></li>
            </ul>
          </div>

          <!-- Acerca de -->
          <div>
            <h3 class="text-white text-sm font-semibold mb-4 uppercase tracking-wider">Acerca de</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/sobre-nosotros/" class="hover:text-white transition-colors">Sobre Nosotros</a></li>
              <li><a href="/contacto/" class="hover:text-white transition-colors">Contacto</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-slate-700 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4">
          <p class="text-sm">&copy; {new Date().getFullYear()} ExcelyDatos. Todos los derechos reservados.</p>
          <p class="text-xs text-slate-500">Hecho con precisión para analistas de datos</p>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>

<style is:global>
  html {
    font-family: 'Inter', system-ui, sans-serif;
  }
  code, pre, kbd {
    font-family: 'JetBrains Mono', 'Fira Code', Menlo, Monaco, 'Courier New', monospace;
  }
</style>
