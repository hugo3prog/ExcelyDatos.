---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  showReadingProgress?: boolean;
}

const {
  title,
  description = 'ExcelyDatos — Aprende Excel, Power BI y SQL desde cero con guías prácticas y directas al punto.',
  canonical = Astro.url.href,
  ogImage = '/og-default.png',
  jsonLd,
  showReadingProgress = false,
} = Astro.props;

const siteName = 'ExcelyDatos';
const jsonLdString = jsonLd ? JSON.stringify(jsonLd) : null;

// Detectamos si el usuario está exactamente en la página de inicio (Home)
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<!doctype html>
<html lang="es" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="any" />
    <meta name="generator" content={Astro.generator} />

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    {jsonLdString && (
      <script type="application/ld+json" set:html={jsonLdString} />
    )}
  </head>
  <body class="bg-[#F8FAFC] dark:bg-slate-950 text-[#1E293B] dark:text-slate-100 font-inter antialiased transition-colors duration-200">

    <!-- Reading progress bar -->
    {showReadingProgress && (
      <div
        id="reading-progress"
        class="fixed top-0 left-0 h-[3px] bg-emerald-600 z-[60] transition-none"
        style="width: 0%"
        aria-hidden="true"
      ></div>
    )}

    <!-- Header / Navigation -->
    <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-28">
          <!-- Logo: muestra el logo recortado de marca en su tamaño definitivo optimizado -->
          <a href="/" class="flex items-center group py-2" aria-label="ExcelyDatos — Inicio">
            <img 
              src="/logo-horizontal.png" 
              alt="ExcelyDatos" 
              class="h-20 sm:h-24 w-auto object-contain dark:brightness-110 transition-transform group-hover:scale-[1.02]"
            />
          </a>

          <!-- Desktop Nav -->
          <nav class="hidden md:flex items-center gap-1">
            <a
              href="/excel/"
              class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/30 transition-colors duration-150"
            >
              Excel & Sheets
            </a>
            <a
              href="/powerbi/"
              class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-amber-700 dark:hover:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-900/30 transition-colors duration-150"
            >
              Power BI
            </a>
            <a
              href="/sql/"
              class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-sky-700 dark:hover:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-900/30 transition-colors duration-150"
            >
              SQL
            </a>

            <!-- Separator -->
            <span class="w-px h-5 bg-slate-200 dark:bg-slate-700 mx-1"></span>

            <!-- Home button -->
            <a
              href="/"
              class="p-2 rounded-md text-slate-500 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              aria-label="Inicio"
              title="Inicio"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
            </a>

            <!-- Dark mode toggle -->
            <button
              id="theme-toggle"
              class="p-2 rounded-md text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              aria-label="Cambiar tema"
            >
              <svg id="icon-sun" class="hidden w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="5"/>
                <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
              </svg>
              <svg id="icon-moon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
            </button>
          </nav>

          <!-- Mobile right controls -->
          <div class="flex items-center gap-1 md:hidden">
            <!-- Home button mobile -->
            <a
              href="/"
              class="p-2 rounded-md text-slate-500 dark:text-slate-400 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              aria-label="Inicio"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
            </a>

            <!-- Dark mode toggle mobile -->
            <button
              id="theme-toggle-mobile"
              class="p-2 rounded-md text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              aria-label="Cambiar tema"
            >
              <svg id="icon-sun-mobile" class="hidden w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="5"/>
                <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
              </svg>
              <svg id="icon-moon-mobile" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
            </button>

            <!-- Mobile menu button -->
            <button
              id="mobile-menu-btn"
              class="p-2 rounded-md text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              aria-label="Abrir menú"
              aria-expanded="false"
            >
              <svg id="menu-icon-open" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="6" x2="21" y2="6"/>
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="3" y1="18" x2="21" y2="18"/>
              </svg>
              <svg id="menu-icon-close" class="hidden w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Nav -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 dark:border-slate-800 py-3 space-y-1">
          <a href="/excel/" class="block px-3 py-2 rounded-md text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-emerald-50 dark:hover:bg-emerald-900/30 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">Excel & Google Sheets</a>
          <a href="/powerbi/" class="block px-3 py-2 rounded-md text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-amber-50 dark:hover:bg-amber-900/30 hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Power BI</a>
          <a href="/sql/" class="block px-3 py-2 rounded-md text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-sky-50 dark:hover:bg-sky-900/30 hover:text-sky-700 dark:hover:text-sky-400 transition-colors">SQL</a>
        </div>
      </div>
    </header>

    <!-- Eliminación absoluta y radical de espacios para pegar el texto de la Home directamente al header -->
    {isHome && (
      <style is:inline>
        main, 
        main > div, 
        main section,
        main .py-24,
        main .py-32,
        main .pt-20 {
          padding-top: 0px !important;
          margin-top: 0px !important;
        }
        main > div:first-of-type > div:first-of-type {
          display: block !important;
          padding-top: 0.5rem !important;
          margin-top: 0px !important;
        }
      </style>
    )}

    <!-- Main content -->
    <main>
      <slot />
    </main>

    <!-- Cookie consent banner -->
    <div
      id="cookie-banner"
      class="fixed bottom-0 left-0 right-0 z-[100] px-4 py-4 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-700 shadow-lg hidden"
      role="region"
      aria-label="Aviso de cookies"
    >
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="flex items-start gap-3 flex-1">
          <svg class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
          </svg>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            Utilizamos cookies propias y de terceros para mejorar tu experiencia de navegación y mostrarte publicidad relevante.
            Al continuar navegando aceptas su uso.
            <a href="/cookies/" class="text-emerald-700 dark:text-emerald-400 font-semibold hover:underline ml-1">Política de Cookies</a>
          </p>
        </div>
        <div class="flex items-center gap-3 flex-shrink-0 w-full sm:w-auto">
          <button
            id="cookie-reject"
            class="text-xs text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 font-medium transition-colors px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800"
          >
            Solo esenciales
          </button>
          <button
            id="cookie-accept"
            class="bg-emerald-700 hover:bg-emerald-800 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors duration-150 whitespace-nowrap shadow-sm"
          >
            Aceptar todo
          </button>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="bg-slate-900 dark:bg-slate-950 text-slate-400 mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-8">

        <!-- Author / About section -->
        <div class="bg-slate-800 dark:bg-slate-900 rounded-2xl p-6 mb-10 border border-slate-700">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-emerald-700 flex items-center justify-center flex-shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-white font-semibold text-sm mb-1">Sobre ExcelyDatos</p>
              <p class="text-slate-300 text-sm leading-relaxed">
                En ExcelyDatos compartimos guías prácticas de oficina para ayudarte a dominar Excel, Power BI y SQL, y ahorrar tiempo real en tu trabajo diario. Cada artículo está escrito desde la experiencia, sin relleno ni teoría innecesaria.
              </p>
              <div class="flex items-center gap-4 mt-3">
                <a href="/sobre-nosotros/" class="inline-flex items-center gap-1 text-emerald-400 hover:text-emerald-300 text-xs font-semibold transition-colors">
                  Conoce más
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <!-- Social links -->
                <div class="flex items-center gap-3 ml-auto">
                  <!-- Instagram -->
                  <a
                    href="#"
                    aria-label="Instagram"
                    class="w-8 h-8 rounded-full bg-slate-700 hover:bg-pink-600 flex items-center justify-center transition-colors duration-200"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                    </svg>
                  </a>
                  <!-- TikTok -->
                  <a
                    href="#"
                    aria-label="TikTok"
                    class="w-8 h-8 rounded-full bg-slate-700 hover:bg-[#010101] flex items-center justify-center transition-colors duration-200"
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="white">
                      <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.86 4.86 0 0 1-1.01-.06z"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- Brand -->
          <div class="md:col-span-1">
            <div class="flex items-center gap-2 mb-4">
              <img 
                src="/favicon.png" 
                alt="Logo ExcelyDatos" 
                class="w-7 h-7 object-contain rounded-md"
              />
              <span class="text-white font-bold">Excely<span class="text-emerald-400">Datos</span></span>
            </div>
            <p class="text-slate-400 text-sm leading-relaxed">
              Guías prácticas de Excel, Power BI y SQL para profesionales que quieren trabajar better con sus datos.
            </p>
          </div>

          <!-- Categorías -->
          <div>
            <h3 class="text-white text-sm font-semibold mb-4 uppercase tracking-wider">Categorías</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/excel/" class="text-slate-400 hover:text-emerald-400 transition-colors">Excel & Google Sheets</a></li>
              <li><a href="/powerbi/" class="text-slate-400 hover:text-amber-400 transition-colors">Power BI</a></li>
              <li><a href="/sql/" class="text-slate-400 hover:text-sky-400 transition-colors">SQL</a></li>
            </ul>
          </div>

          <!-- Legal -->
          <div>
            <h3 class="text-white text-sm font-semibold mb-4 uppercase tracking-wider">Legal</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/privacidad/" class="text-slate-400 hover:text-white transition-colors">Política de Privacidad</a></li>
              <li><a href="/cookies/" class="text-slate-400 hover:text-white transition-colors">Política de Cookies</a></li>
              <li><a href="/aviso-legal/" class="text-slate-400 hover:text-white transition-colors">Aviso Legal</a></li>
            </ul>
          </div>

          <!-- Acerca de -->
          <div>
            <h3 class="text-white text-sm font-semibold mb-4 uppercase tracking-wider">Acerca de</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/sobre-nosotros/" class="text-slate-400 hover:text-white transition-colors">Sobre Nosotros</a></li>
              <li><a href="/contacto/" class="text-slate-400 hover:text-white transition-colors">Contacto</a></li>
            </ul>
          </div>
        </div>

        <div class="border-t border-slate-700 dark:border-slate-800 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4">
          <p class="text-slate-400 text-sm">&copy; {new Date().getFullYear()} ExcelyDatos. Todos los derechos reservados.</p>
          <p class="text-slate-500 text-xs">Hecho con precisión para analistas de datos</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        function getTheme() {
          return localStorage.getItem('theme') || 'light';
        }
        function applyTheme(theme) {
          var html = document.documentElement;
          if (theme === 'dark') {
            html.classList.add('dark');
            html.classList.remove('light');
          } else {
            html.classList.remove('dark');
            html.classList.add('light');
          }
          var sunIcons = document.querySelectorAll('[id^="icon-sun"]');
          var moonIcons = document.querySelectorAll('[id^="icon-moon"]');
          sunIcons.forEach(function(el) { el.classList.toggle('hidden', theme !== 'dark'); });
          moonIcons.forEach(function(el) { el.classList.toggle('hidden', theme === 'dark'); });
        }
        applyTheme(getTheme());

        document.addEventListener('DOMContentLoaded', function () {
          applyTheme(getTheme());

          // Cookie consent
          var cookieBanner = document.getElementById('cookie-banner');
          var cookieAccept = document.getElementById('cookie-accept');
          var cookieReject = document.getElementById('cookie-reject');
          if (cookieBanner && !localStorage.getItem('cookie-consent')) {
            setTimeout(function() { cookieBanner.classList.remove('hidden'); }, 800);
          }
          function dismissCookies(value) {
            localStorage.setItem('cookie-consent', value);
            if (cookieBanner) {
              cookieBanner.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
              cookieBanner.style.transform = 'translateY(100%)';
              cookieBanner.style.opacity = '0';
              setTimeout(function() { cookieBanner.classList.add('hidden'); }, 300);
            }
          }
          if (cookieAccept) cookieAccept.addEventListener('click', function() { dismissCookies('all'); });
          if (cookieReject) cookieReject.addEventListener('click', function() { dismissCookies('essential'); });

          // Mobile menu
          var btn = document.getElementById('mobile-menu-btn');
          var menu = document.getElementById('mobile-menu');
          var iconOpen = document.getElementById('menu-icon-open');
          var iconClose = document.getElementById('menu-icon-close');
          if (btn && menu) {
            btn.addEventListener('click', function () {
              var isHidden = menu.classList.contains('hidden');
              menu.classList.toggle('hidden', !isHidden);
              if (iconOpen) iconOpen.classList.toggle('hidden', !isHidden);
              if (iconClose) iconClose.classList.toggle('hidden', isHidden);
              btn.setAttribute('aria-expanded', String(!isHidden));
            });
          }

          // Theme toggles
          function toggleTheme() {
            var next = getTheme() === 'dark' ? 'light' : 'dark';
            localStorage.setItem('theme', next);
            applyTheme(next);
          }
          var t1 = document.getElementById('theme-toggle');
          var t2 = document.getElementById('theme-toggle-mobile');
          if (t1) t1.addEventListener('click', toggleTheme);
          if (t2) t2.addEventListener('click', toggleTheme);

          // Reading progress bar
          var progressBar = document.getElementById('reading-progress');
          if (progressBar) {
            function updateProgress() {
              var docHeight = document.documentElement.scrollHeight - window.innerHeight;
              var progress = docHeight > 0 ? (window.scrollY / docHeight) * 100 : 0;
              progressBar.style.width = Math.min(progress, 100) + '%';
            }
            window.addEventListener('scroll', updateProgress, { passive: true });
            updateProgress();
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  html {
    font-family: 'Inter', system-ui, sans-serif;
  }
  code, pre, kbd {
    font-family: 'JetBrains Mono', 'Fira Code', Menlo, Monaco, 'Courier New', monospace;
  }
</style>
