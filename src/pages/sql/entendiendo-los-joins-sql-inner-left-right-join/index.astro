const description = 'Aprende qué son los JOINs en SQL y cuándo usar INNER JOIN, LEFT JOIN y RIGHT JOIN con ejemplos reales de oficina y tablas de clientes, pedidos y ventas.';
const publishDate = '2025-09-15';
const updateDate = '2026-07-22';
const readTime = '8 min';
const url = 'https://excelydatos.com/sql/entendiendo-los-joins-sql-inner-left-right-join/';

const jsonLd = [
  { "@context": "https://schema.org", "@type": "Article", "headline": title, "description": description, "datePublished": publishDate, "dateModified": updateDate, "author": { "@type": "Organization", "name": "ExcelyDatos", "url": "https://excelydatos.com" }, "publisher": { "@type": "Organization", "name": "ExcelyDatos", "url": "https://excelydatos.com" }, "mainEntityOfPage": { "@type": "WebPage", "@id": url } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://excelydatos.com/" }, { "@type": "ListItem", "position": 2, "name": "SQL", "item": "https://excelydatos.com/sql/" }, { "@type": "ListItem", "position": 3, "name": "JOINs en SQL", "item": url } ] }
];
---

<Layout title={`${title} — ExcelyDatos`} description={description} jsonLd={jsonLd} showReadingProgress={true}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="adsense-slot adsense-slot--leaderboard mb-8" aria-hidden="true"></div>
