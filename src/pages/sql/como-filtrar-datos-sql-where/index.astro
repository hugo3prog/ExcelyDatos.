    "headline": title,
    "description": description,
    "datePublished": publishDate,
    "dateModified": updateDate,
    "author": { "@type": "Organization", "name": "ExcelyDatos", "url": "https://excelydatos.com" },
    "publisher": { "@type": "Organization", "name": "ExcelyDatos", "url": "https://excelydatos.com" },
