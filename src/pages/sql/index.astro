---
import '@/styles/globals.css';
import Layout from '../../layouts/Layout.astro';

const articles = [
  {
    title: '¿Qué es un SELECT en SQL? Aprende a consultar tus datos en 5 minutos',
    excerpt: 'La instrucción más usada en SQL explicada desde cero. SELECT, WHERE, ORDER BY y LIMIT con ejemplos reales de oficina.',
    href: '/sql/que-es-un-select-en-sql/',
    readTime: '5 min',
    tag: 'Principiante',
    tagColor: 'bg-sky-100 dark:bg-sky-900/50 text-sky-800 dark:text-sky-300',
  },
];
---

<Layout
  title="SQL — Guías prácticas | ExcelyDatos"
  description="Aprende SQL desde cero con guías prácticas en español. SELECT, JOIN, GROUP BY, subconsultas y mucho más explicado con ejemplos reales."
>
  <!-- Hero silo -->
  <section class="bg-gradient-to-br from-sky-600 to-sky-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <ellipse cx="12" cy="6" rx="9" ry="3" fill="white" opacity="0.9"/>
            <path d="M3 6v5c0 1.657 4.03 3 9 3s9-1.343 9-3V6" stroke="white" stroke-width="1.5" fill="none" opacity="0.7"/>
            <path d="M3 11v5c0 1.657 4.03 3 9 3s9-1.343 9-3v-5" stroke="white" stroke-width="1.5" fill="none" opacity="0.4"/>
          </svg>
        </div>
        <span class="text-sky-200 font-semibold text-sm uppercase tracking-wider">Categoría</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">SQL</h1>
      <p class="text-sky-100 text-lg max-w-2xl leading-relaxed">
        Aprende a hablar con tus bases de datos. Desde el SELECT más básico hasta consultas complejas con JOIN y agregaciones. Cada artículo tiene ejemplos que puedes probar en el acto.
      </p>
      <div class="flex flex-wrap gap-2 mt-8">
        {['SELECT y WHERE', 'JOIN entre tablas', 'GROUP BY', 'Subconsultas', 'Índices', 'Funciones de ventana', 'MySQL', 'PostgreSQL'].map(tag => (
          <span class="bg-white/10 text-sky-100 text-xs font-medium px-3 py-1.5 rounded-full">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Cover image -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 relative z-10">
    <div class="rounded-2xl overflow-hidden shadow-lg">
      <img
        src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=1400&q=80"
        alt="Servidor de base de datos y terminal con código de consultas SQL"
        class="w-full max-h-[320px] object-cover"
        loading="eager"
        width="1400"
        height="320"
      />
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="adsense-slot adsense-slot--leaderboard mb-10" aria-hidden="true"></div>

    <div class="flex gap-10">
      <div class="flex-1 min-w-0">
        <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-6 flex items-center gap-2">
          <span class="w-1 h-5 bg-sky-500 rounded-full inline-block"></span>
          Artículos publicados
        </h2>

        <div class="space-y-5">
          {articles.map((article) => (
            <article class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-sky-300 dark:hover:border-sky-700 hover:shadow-md transition-all duration-200 p-6 flex gap-5">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-2">
                  <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${article.tagColor}`}>{article.tag}</span>
                  <span class="text-slate-400 dark:text-slate-500 text-xs">{article.readTime} de lectura</span>
                </div>
                <h3 class="font-bold text-slate-900 dark:text-slate-100 mb-2 leading-snug">
                  <a href={article.href} class="hover:text-sky-700 dark:hover:text-sky-400 transition-colors">{article.title}</a>
                </h3>
                <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed">{article.excerpt}</p>
              </div>
              <div class="hidden sm:flex items-center">
                <a href={article.href} class="text-sky-600 dark:text-sky-400 hover:text-sky-800 dark:hover:text-sky-300 transition-colors" aria-label="Leer artículo">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-8 bg-sky-50 dark:bg-sky-900/20 border border-dashed border-sky-200 dark:border-sky-800 rounded-2xl p-8 text-center">
          <p class="text-sky-700 dark:text-sky-400 font-semibold mb-1">Más guías en camino</p>
          <p class="text-sky-600 dark:text-sky-500 text-sm">Próximamente: JOIN paso a paso, GROUP BY con ejemplos reales y funciones de ventana.</p>
        </div>
      </div>

      <aside class="hidden lg:block w-72 flex-shrink-0 space-y-6">
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5">
          <h3 class="font-bold text-slate-900 dark:text-slate-100 text-sm mb-4">Otras categorías</h3>
          <div class="space-y-2">
            <a href="/excel/" class="flex items-center gap-2 text-sm text-emerald-700 dark:text-emerald-400 hover:text-emerald-900 dark:hover:text-emerald-300 font-medium transition-colors py-1.5">
              <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
              Excel & Google Sheets
            </a>
            <a href="/powerbi/" class="flex items-center gap-2 text-sm text-amber-700 dark:text-amber-400 hover:text-amber-900 dark:hover:text-amber-300 font-medium transition-colors py-1.5">
              <span class="w-2 h-2 bg-amber-400 rounded-full"></span>
              Power BI
            </a>
          </div>
        </div>
        <div class="adsense-slot adsense-slot--sidebar sticky top-24" aria-hidden="true"></div>
      </aside>
    </div>
  </div>
</Layout>
