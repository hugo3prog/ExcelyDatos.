---
import '@/styles/globals.css';
import Layout from '../layouts/Layout.astro';

const featuredArticles = [
  {
    title: 'Cómo sumar celdas en Excel: Guía rápida para principiantes (y el truco del teclado)',
    excerpt: 'Aprende a usar SUMA, sumar rangos discontinuos y el atajo de teclado que te ahorra tiempo en cualquier hoja de cálculo.',
    category: 'Excel',
    badge: 'badge-excel',
    accent: 'emerald',
    href: '/excel/como-sumar-celdas-en-excel/',
    featured: true,
    readTime: '5 min',
    keywords: 'excel suma fórmulas hoja de cálculo',
  },
  {
    title: 'Cómo conectar Excel con Power BI paso a paso (sin dar errores)',
    excerpt: 'Una guía directa para importar tu libro de Excel en Power BI Desktop sin pasos innecesarios ni configuraciones complicadas.',
    category: 'Power BI',
    badge: 'badge-powerbi',
    accent: 'amber',
    href: '/powerbi/como-conectar-excel-con-power-bi/',
    featured: false,
    readTime: '7 min',
    keywords: 'power bi excel conectar importar dashboard',
  },
  {
    title: '¿Qué es un SELECT en SQL? Aprende a consultar tus datos en 5 minutos',
    excerpt: 'Entiende cómo funciona la instrucción SELECT desde cero, con ejemplos reales de oficina y sin necesidad de instalar nada.',
    category: 'SQL',
    badge: 'badge-sql',
    accent: 'sky',
    href: '/sql/que-es-un-select-en-sql/',
    featured: false,
    readTime: '5 min',
    keywords: 'sql select consulta base de datos where',
  },
  {
    title: 'Cómo crear tu primer gráfico interactivo en Power BI en 3 pasos (sin morir en el intento)',
    excerpt: 'Guía paso a paso para crear tu primer gráfico interactivo en Power BI. Desde conectar datos hasta un dashboard funcional en menos de 30 minutos.',
    category: 'Power BI',
    badge: 'badge-powerbi',
    accent: 'amber',
    href: '/powerbi/crear-primer-grafico-interactivo-power-bi/',
    featured: false,
    readTime: '8 min',
    keywords: 'power bi grafico dashboard interactivo segmentador',
  },
  {
    title: 'Cómo ordenar tus consultas con ORDER BY en SQL: ejemplos prácticos para oficina',
    excerpt: 'Aprende a ordenar resultados en SQL con ORDER BY, ASC, DESC y varias columnas, con ejemplos reales de oficina y errores comunes.',
    category: 'SQL',
    badge: 'badge-sql',
    accent: 'sky',
    href: '/sql/como-ordenar-consultas-sql-order-by/',
    featured: false,
    readTime: '7 min',
    keywords: 'sql order by asc desc ordenar consulta',
  },
  {
    title: 'Guía para principiantes: cómo filtrar datos con la cláusula WHERE en SQL',
    excerpt: 'Aprende a filtrar datos con WHERE en SQL usando operadores, rangos, listas y patrones, con ejemplos reales de oficina y trucos para no complicarte.',
    category: 'SQL',
    badge: 'badge-sql',
    accent: 'sky',
    href: '/sql/como-filtrar-datos-sql-where/',
    featured: false,
    readTime: '8 min',
    keywords: 'sql where filtrar and or in between like is null',
  },
  {
    title: 'Cómo quitar duplicados en Excel con un solo clic (sin romper tu tabla)',
    excerpt: 'Elimina filas repetidas en Excel y Google Sheets de forma segura. Limpia tus bases de datos sin desordenar la información y evita el error de borrar lo que no debes.',
    category: 'Excel',
    badge: 'badge-excel',
    accent: 'emerald',
    href: '/excel/como-quitar-duplicados-excel/',
    featured: false,
    readTime: '6 min',
    keywords: 'excel duplicados quitar limpiar datos google sheets',
  },
  {
    title: 'Cómo arreglar el error #N/A en BUSCARV cuando estás seguro de que el dato existe',
    excerpt: '¿Tu BUSCARV da #N/A pero estás viendo el dato con tus propios ojos? Descubre los fallos de formato y espacios ocultos y cómo solucionarlos rápido en Excel y Google Sheets.',
    category: 'Excel',
    badge: 'badge-excel',
    accent: 'emerald',
    href: '/excel/error-na-buscarv-dato-existe/',
    featured: false,
    readTime: '7 min',
    keywords: 'excel buscarv error na espacios formato sierror',
  },
  {
    title: 'Cómo calcular porcentajes en Excel y Sheets sin liarte con la regla de tres',
    excerpt: 'Aprende a calcular porcentajes, márgenes de beneficio y descuentos en Excel y Google Sheets con fórmulas sencillas y ejemplos reales de oficina.',
    category: 'Excel',
    badge: 'badge-excel',
    accent: 'emerald',
    href: '/excel/como-calcular-porcentaje-en-excel/',
    featured: false,
    readTime: '6 min',
    keywords: 'excel porcentaje margen descuento iva formula',
  },
  {
    title: 'Entendiendo los JOINs de SQL: Diferencias reales entre INNER, LEFT y RIGHT JOIN',
    excerpt: 'Aprende qué son los JOINs en SQL y cuándo usar INNER JOIN, LEFT JOIN y RIGHT JOIN con ejemplos reales de oficina y tablas de clientes, pedidos y ventas.',
    category: 'SQL',
    badge: 'badge-sql',
    accent: 'sky',
    href: '/sql/entendiendo-los-joins-sql-inner-left-right-join/',
    featured: false,
    readTime: '8 min',
    keywords: 'sql join inner left right union tablas',
  },
  {
    title: 'Por qué tu informe de Power BI va lento: 3 trucos con DAX para acelerar el rendimiento',
    excerpt: 'Descubre por qué tu informe de Power BI es lento y aprende 3 trucos prácticos con DAX para optimizar el rendimiento: medidas, CALCULATE y variables.',
    category: 'Power BI',
    badge: 'badge-powerbi',
    accent: 'amber',
    href: '/powerbi/por-que-tu-informe-power-bi-va-lento-trucos-dax/',
    featured: false,
    readTime: '7 min',
    keywords: 'power bi dax rendimiento lento calculate variables medidas',
  },
];
---

<Layout
  title="ExcelyDatos — Excel, Power BI y SQL para analistas de datos"
  description="Aprende Excel, Power BI y SQL con guías prácticas en español. Sin relleno, sin teoría innecesaria: solo lo que necesitas para trabajar mejor con tus datos."
>
  <!-- AdSense Leaderboard Top -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <div class="adsense-slot adsense-slot--leaderboard" aria-hidden="true"></div>
  </div>

  <!-- ===================== HERO ===================== -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-emerald-50 via-[#F8FAFC] to-sky-50 dark:from-emerald-950/30 dark:via-slate-950 dark:to-sky-950/30 opacity-70"></div>
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, #e2e8f0 1px, transparent 0); background-size: 32px 32px; opacity: 0.4;"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
      <div class="max-w-3xl">

        <!-- Hero logo banner: shows the full logo (left half of the brand image) -->
        <div class="w-full max-w-sm mb-8 flex justify-start">
          <div
            class="h-20"
            style="width: 100%; max-width: 320px; background-image: url('/Gemini_Generated_Image_p0eu1zp0eu1zp0eu.png'); background-size: 200% 100%; background-position: left center; background-repeat: no-repeat;"
            role="img"
            aria-label="ExcelyDatos"
          ></div>
        </div>

        <div class="inline-flex items-center gap-2 bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300 text-xs font-semibold px-3 py-1.5 rounded-full mb-6">
          <span class="w-1.5 h-1.5 bg-emerald-600 rounded-full animate-pulse"></span>
          Excel, Power BI y SQL en español
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-[#1E293B] dark:text-white leading-tight mb-6">
          Tus datos,<br />
          <span class="text-emerald-700 dark:text-emerald-400">bajo control.</span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed mb-8 max-w-2xl">
          Guías prácticas y directas para aprender a manejar Excel, Power BI y SQL.
          Sin introducciones eternas ni teoría innecesaria: cada artículo resuelve una duda concreta desde el primer párrafo.
        </p>

        <!-- Search bar -->
        <div class="relative max-w-xl mb-8">
          <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
          </div>
          <input
            id="article-search"
            type="search"
            placeholder="Buscar artículos... (ej: SUMA, Power Query, SELECT)"
            class="w-full pl-12 pr-4 py-3.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-700 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent shadow-sm transition-all"
            autocomplete="off"
          />
          <div
            id="search-suggestions"
            class="hidden absolute top-full left-0 right-0 mt-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-lg z-50 overflow-hidden"
          ></div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="/excel/"
            class="inline-flex items-center justify-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold px-6 py-3 rounded-lg transition-colors duration-200 shadow-sm"
          >
            Empezar con Excel
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a
            href="#articulos"
            class="inline-flex items-center justify-center gap-2 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-[#1E293B] dark:text-slate-100 font-semibold px-6 py-3 rounded-lg border border-slate-200 dark:border-slate-700 transition-colors duration-200"
          >
            Ver artículos recientes
          </a>
        </div>

        <!-- Stats row -->
        <div class="flex flex-wrap gap-6 mt-12 pt-8 border-t border-slate-200 dark:border-slate-700">
          <div>
            <div class="text-2xl font-bold text-emerald-700 dark:text-emerald-400">Guías detalladas</div>
            <div class="text-sm text-slate-500 dark:text-slate-400">paso a paso</div>
          </div>
          <div class="w-px bg-slate-200 dark:bg-slate-700"></div>
          <div>
            <div class="text-2xl font-bold text-[#1E293B] dark:text-slate-100">3</div>
            <div class="text-sm text-slate-500 dark:text-slate-400">Categorías especializadas</div>
          </div>
          <div class="w-px bg-slate-200 dark:bg-slate-700"></div>
          <div>
            <div class="text-2xl font-bold text-[#1E293B] dark:text-slate-100">100%</div>
            <div class="text-sm text-slate-500 dark:text-slate-400">Contenido en español</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SILO CARDS ===================== -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-[#1E293B] dark:text-slate-100 mb-3">Elige tu área de aprendizaje</h2>
      <p class="text-slate-500 dark:text-slate-400 max-w-xl mx-auto">Cada categoría es un silo independiente con artículos organizados por nivel y tema.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Excel — Featured / Larger -->
      <div class="lg:col-span-2 group relative bg-white dark:bg-slate-800 rounded-2xl border border-emerald-100 dark:border-emerald-900/50 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 overflow-hidden">
        <div class="h-1.5 bg-gradient-to-r from-emerald-500 to-emerald-700"></div>
        <div class="p-8">
          <div class="flex items-start justify-between mb-6">
            <div class="w-14 h-14 bg-emerald-100 dark:bg-emerald-900/40 rounded-xl flex items-center justify-center">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="2" width="11" height="11" rx="2" fill="#047857"/>
                <rect x="15" y="2" width="11" height="11" rx="2" fill="#6ee7b7"/>
                <rect x="2" y="15" width="11" height="11" rx="2" fill="#6ee7b7"/>
                <rect x="15" y="15" width="11" height="11" rx="2" fill="#047857" opacity="0.7"/>
              </svg>
            </div>
            <span class="bg-emerald-700 text-white text-xs font-bold px-3 py-1 rounded-full">Principal</span>
          </div>
          <h3 class="text-2xl font-bold text-[#1E293B] dark:text-slate-100 mb-3">Excel & Google Sheets</h3>
          <p class="text-slate-500 dark:text-slate-400 leading-relaxed mb-6">
            Desde fórmulas básicas hasta tablas dinámicas avanzadas. Aprende a automatizar tareas repetitivas,
            crear dashboards funcionales y dominar las funciones que más se usan en entornos de trabajo reales.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 text-xs font-medium px-2.5 py-1 rounded-md">Fórmulas</span>
            <span class="bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 text-xs font-medium px-2.5 py-1 rounded-md">Tablas dinámicas</span>
            <span class="bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 text-xs font-medium px-2.5 py-1 rounded-md">XLOOKUP</span>
            <span class="bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 text-xs font-medium px-2.5 py-1 rounded-md">Macros VBA</span>
            <span class="bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 text-xs font-medium px-2.5 py-1 rounded-md">Power Query</span>
          </div>
          <a
            href="/excel/"
            class="inline-flex items-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold px-5 py-2.5 rounded-lg text-sm transition-colors duration-200"
          >
            Explorar Excel
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Right column: Power BI + SQL stacked -->
      <div class="flex flex-col gap-6">
        <!-- Power BI -->
        <div class="group bg-white dark:bg-slate-800 rounded-2xl border border-amber-100 dark:border-amber-900/50 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 overflow-hidden flex-1">
          <div class="h-1.5 bg-gradient-to-r from-amber-400 to-amber-600"></div>
          <div class="p-6">
            <div class="w-11 h-11 bg-amber-100 dark:bg-amber-900/40 rounded-xl flex items-center justify-center mb-4">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="14" width="4" height="8" rx="1" fill="#D97706"/>
                <rect x="8" y="9" width="4" height="13" rx="1" fill="#D97706" opacity="0.7"/>
                <rect x="14" y="5" width="4" height="17" rx="1" fill="#D97706" opacity="0.5"/>
                <rect x="20" y="2" width="2" height="20" rx="1" fill="#D97706" opacity="0.3"/>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#1E293B] dark:text-slate-100 mb-2">Power BI</h3>
            <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mb-4">
              Crea dashboards visuales que hablan por sí solos. Conecta tus datos y genera informes en minutos.
            </p>
            <a href="/powerbi/" class="inline-flex items-center gap-1.5 text-amber-700 dark:text-amber-400 hover:text-amber-900 dark:hover:text-amber-300 font-semibold text-sm transition-colors">
              Ver guías
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- SQL -->
        <div class="group bg-white dark:bg-slate-800 rounded-2xl border border-sky-100 dark:border-sky-900/50 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 overflow-hidden flex-1">
          <div class="h-1.5 bg-gradient-to-r from-sky-400 to-sky-600"></div>
          <div class="p-6">
            <div class="w-11 h-11 bg-sky-100 dark:bg-sky-900/40 rounded-xl flex items-center justify-center mb-4">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="12" cy="6" rx="9" ry="3" fill="#0284C7" opacity="0.8"/>
                <path d="M3 6v5c0 1.657 4.03 3 9 3s9-1.343 9-3V6" stroke="#0284C7" stroke-width="1.5" fill="none"/>
                <path d="M3 11v5c0 1.657 4.03 3 9 3s9-1.343 9-3v-5" stroke="#0284C7" stroke-width="1.5" fill="none" opacity="0.5"/>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#1E293B] dark:text-slate-100 mb-2">SQL</h3>
            <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mb-4">
              Consulta y transforma bases de datos con confianza. Aprende SELECT, JOIN, GROUP BY y mucho más.
            </p>
            <a href="/sql/" class="inline-flex items-center gap-1.5 text-sky-700 dark:text-sky-400 hover:text-sky-900 dark:hover:text-sky-300 font-semibold text-sm transition-colors">
              Ver guías
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AdSense mid-page -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 my-4">
    <div class="adsense-slot adsense-slot--leaderboard" aria-hidden="true"></div>
  </div>

  <!-- ===================== ÚLTIMOS ARTÍCULOS ===================== -->
  <section id="articulos" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-10">
      <div>
        <h2 class="text-3xl font-bold text-[#1E293B] dark:text-slate-100 mb-2">Últimos artículos publicados</h2>
        <p class="text-slate-500 dark:text-slate-400">Las guías más recientes, listas para aplicar hoy mismo.</p>
      </div>
    </div>

    <div class="max-w-xl mx-auto my-8 px-4">
      <div class="relative">
        <input
          type="text"
          id="search-input"
          placeholder="Buscar tutoriales de Excel, Power BI, SQL..."
          class="w-full px-5 py-3 pl-12 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-emerald-600 text-gray-800 shadow-sm"
        />
        <svg class="w-6 h-6 text-gray-400 absolute left-3 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>

    <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredArticles.map((article) => (
        <article
          class={`article-card bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 overflow-hidden flex flex-col ${article.featured ? 'md:col-span-1 ring-2 ring-emerald-200 dark:ring-emerald-800' : ''}`}
          data-title={article.title.toLowerCase()}
          data-keywords={article.keywords}
        >
          <div class={`h-1 ${article.accent === 'emerald' ? 'bg-emerald-600' : article.accent === 'amber' ? 'bg-amber-500' : 'bg-sky-500'}`}></div>

          <div class={`h-40 flex items-center justify-center ${article.accent === 'emerald' ? 'bg-emerald-50 dark:bg-emerald-900/20' : article.accent === 'amber' ? 'bg-amber-50 dark:bg-amber-900/20' : 'bg-sky-50 dark:bg-sky-900/20'}`}>
            {article.accent === 'emerald' && (
              <svg width="56" height="56" viewBox="0 0 56 56" fill="none" class="opacity-30">
                <rect x="4" y="4" width="22" height="22" rx="3" fill="#047857"/>
                <rect x="30" y="4" width="22" height="22" rx="3" fill="#047857" opacity="0.5"/>
                <rect x="4" y="30" width="22" height="22" rx="3" fill="#047857" opacity="0.5"/>
                <rect x="30" y="30" width="22" height="22" rx="3" fill="#047857" opacity="0.7"/>
              </svg>
            )}
            {article.accent === 'amber' && (
              <svg width="56" height="56" viewBox="0 0 56 56" fill="none" class="opacity-30">
                <rect x="4" y="30" width="10" height="22" rx="2" fill="#D97706"/>
                <rect x="18" y="22" width="10" height="30" rx="2" fill="#D97706" opacity="0.8"/>
                <rect x="32" y="14" width="10" height="38" rx="2" fill="#D97706" opacity="0.6"/>
                <rect x="46" y="6" width="6" height="46" rx="2" fill="#D97706" opacity="0.4"/>
              </svg>
            )}
            {article.accent === 'sky' && (
              <svg width="56" height="56" viewBox="0 0 56 56" fill="none" class="opacity-30">
                <ellipse cx="28" cy="14" rx="22" ry="8" fill="#0284C7" opacity="0.8"/>
                <path d="M6 14v14c0 4.418 9.85 8 22 8s22-3.582 22-8V14" stroke="#0284C7" stroke-width="3" fill="none"/>
                <path d="M6 28v14c0 4.418 9.85 8 22 8s22-3.582 22-8V28" stroke="#0284C7" stroke-width="3" fill="none" opacity="0.5"/>
              </svg>
            )}
          </div>

          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-center gap-2 mb-3">
              <span class={article.badge}>{article.category}</span>
              <span class="text-slate-400 text-xs">{article.readTime} de lectura</span>
              {article.featured && (
                <span class="ml-auto bg-emerald-700 text-white text-xs font-bold px-2 py-0.5 rounded">Destacado</span>
              )}
            </div>

            <h3 class="text-base font-bold text-[#1E293B] dark:text-slate-100 leading-snug mb-3 flex-1">
              <a href={article.href} class={`hover:text-${article.accent}-700 dark:hover:text-${article.accent}-400 transition-colors`}>
                {article.title}
              </a>
            </h3>

            <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-5">{article.excerpt}</p>

            <a
              href={article.href}
              class={`inline-flex items-center gap-1.5 text-sm font-semibold transition-colors ${article.accent === 'emerald' ? 'text-emerald-700 hover:text-emerald-900' : article.accent === 'amber' ? 'text-amber-700 hover:text-amber-900' : 'text-sky-700 hover:text-sky-900'}`}
            >
              Leer artículo
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty state for search -->
    <div id="search-empty" class="hidden text-center py-16">
      <div class="w-16 h-16 bg-slate-100 dark:bg-slate-800 rounded-2xl flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </div>
      <p class="text-slate-600 dark:text-slate-400 font-semibold mb-1">Sin resultados</p>
      <p class="text-slate-400 dark:text-slate-500 text-sm">Prueba con otro término de búsqueda.</p>
    </div>
  </section>

  <!-- ===================== NEWSLETTER ===================== -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-[#00754a] text-white py-12 px-6 rounded-2xl text-center my-10 shadow-lg">
      <h2 class="text-3xl font-bold mb-3">Recibe nuevas guías cada semana</h2>
      <p class="text-base sm:text-lg opacity-90 max-w-2xl mx-auto mb-6">
        Sin spam. Solo artículos prácticos sobre Excel, Power BI y SQL que puedes aplicar en tu trabajo de inmediato.
      </p>

      <div id="newsletter-container" class="max-w-md mx-auto min-h-[50px] flex flex-col justify-center items-center">
        <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 w-full justify-center">
          <input
            type="email"
            id="newsletter-email"
            name="email"
            placeholder="Tu correo electrónico..."
            required
            class="px-4 py-3 rounded-xl text-gray-900 bg-white border border-transparent focus:outline-none focus:ring-2 focus:ring-emerald-300 flex-1 text-base shadow-sm"
          />
          <button
            type="submit"
            id="newsletter-btn"
            class="px-6 py-3 bg-gray-900 text-white font-semibold rounded-xl hover:bg-black transition-all shadow-md active:scale-95 whitespace-nowrap"
          >
            Suscribirme
          </button>
        </form>

        <div id="newsletter-message" class="hidden text-amber-200 font-medium text-lg mt-2">
          ¡Gracias por suscribirte! Revisa tu bandeja de entrada.
        </div>
      </div>

      <p class="text-xs opacity-75 mt-4">Puedes darte de baja cuando quieras.</p>
    </div>
  </section>

  <!-- AdSense Bottom -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="adsense-slot adsense-slot--leaderboard" aria-hidden="true"></div>
  </div>
</Layout>

<script is:inline>
  (function () {
    /* Show hero logo if image exists */
    var heroWrap = document.getElementById('hero-logo-wrap');
    var heroImg = document.getElementById('hero-logo-img');
    if (heroWrap && heroImg) {
      var t = new Image();
      t.onload = function() { heroWrap.style.removeProperty('display'); heroWrap.style.display = 'flex'; };
      t.src = '/logo-horizontal.png';
    }

    /* ===================== SEARCH WITH AUTOCOMPLETE ===================== */
    var searchInput = document.getElementById('article-search');
    var suggestionsBox = document.getElementById('search-suggestions');
    var articlesGrid = document.getElementById('articles-grid');
    var emptyState = document.getElementById('search-empty');

    var articles = [
      { title: 'Cómo sumar celdas en Excel: Guía rápida para principiantes (y el truco del teclado)', href: '/excel/como-sumar-celdas-en-excel/', keywords: 'excel suma fórmulas hoja de cálculo' },
      { title: 'Cómo hacer una tabla dinámica en Excel desde cero en menos de 5 minutos', href: '/excel/como-hacer-tabla-dinamica/', keywords: 'excel tabla dinámica resumen filtros' },
      { title: 'Guía básica de la función BUSCARV: Qué es y cómo se usa paso a paso', href: '/excel/guia-buscarv-paso-a-paso/', keywords: 'excel buscarv función búsqueda fórmula' },
      { title: 'Cómo fijar filas y columnas en Excel para que no se muevan al hacer scroll', href: '/excel/como-fijar-filas-columnas/', keywords: 'excel fijar inmovilizar paneles scroll' },
      { title: 'Cómo conectar Excel con Power BI paso a paso (sin dar errores)', href: '/powerbi/como-conectar-excel-con-power-bi/', keywords: 'power bi excel conectar importar dashboard' },
      { title: '¿Qué es un SELECT en SQL? Aprende a consultar tus datos en 5 minutos', href: '/sql/que-es-un-select-en-sql/', keywords: 'sql select consulta base de datos where' },
      { title: 'Cómo crear tu primer gráfico interactivo en Power BI en 3 pasos', href: '/powerbi/crear-primer-grafico-interactivo-power-bi/', keywords: 'power bi grafico dashboard interactivo segmentador' },
      { title: 'Cómo ordenar tus consultas con ORDER BY en SQL: ejemplos prácticos', href: '/sql/como-ordenar-consultas-sql-order-by/', keywords: 'sql order by asc desc ordenar consulta' },
      { title: 'Cómo filtrar datos con la cláusula WHERE en SQL', href: '/sql/como-filtrar-datos-sql-where/', keywords: 'sql where filtrar and or in between like is null' },
      { title: 'Cómo quitar duplicados en Excel con un solo clic (sin romper tu tabla)', href: '/excel/como-quitar-duplicados-excel/', keywords: 'excel duplicados quitar limpiar datos google sheets' },
      { title: 'Cómo arreglar el error #N/A en BUSCARV cuando el dato existe', href: '/excel/error-na-buscarv-dato-existe/', keywords: 'excel buscarv error na espacios formato sierror' },
      { title: 'Cómo calcular porcentajes en Excel sin liarte con la regla de tres', href: '/excel/como-calcular-porcentaje-en-excel/', keywords: 'excel porcentaje margen descuento iva formula' },
      { title: 'Cómo contar celdas con texto o números en Excel (CONTAR vs CONTARA)', href: '/excel/contar-celdas-texto-numeros-excel-contara/', keywords: 'excel contar contara count counta celdas texto numeros' },
      { title: 'Cómo pasar un PDF a Excel sin desconfigurar las tablas', href: '/excel/pasar-pdf-a-excel-sin-desconfigurar/', keywords: 'excel pdf power query importar tablas convertir' },
      { title: 'Entendiendo los JOINs de SQL: INNER, LEFT y RIGHT JOIN', href: '/sql/entendiendo-los-joins-sql-inner-left-right-join/', keywords: 'sql join inner left right union tablas' },
      { title: 'Cómo encontrar datos duplicados en SQL y eliminarlos seguro', href: '/sql/encontrar-datos-duplicados-sql-eliminarlos-seguro/', keywords: 'sql duplicados group by having delete count' },
      { title: 'Diferencia entre WHERE y HAVING en SQL: cuándo usar cada uno', href: '/sql/diferencia-where-having-sql/', keywords: 'sql where having group by filtrar agregadas' },
      { title: 'Por qué tu informe de Power BI va lento: trucos DAX', href: '/powerbi/por-que-tu-informe-power-bi-va-lento-trucos-dax/', keywords: 'power bi dax rendimiento lento calculate variables medidas' },
      { title: 'Cómo usar la función CALCULATE en DAX: guía práctica', href: '/powerbi/como-usar-la-funcion-calculate-en-dax/', keywords: 'power bi dax calculate filtros medidas power bi' },
      { title: 'BUSCARV en Power BI: RELATED vs Combinar Consultas', href: '/powerbi/buscarv-power-bi-diferencia-related-combinar-consultas/', keywords: 'power bi buscarv related lookupvalue combinar consultas power query' }
    ];

    function normalize(str) {
      return (str || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function renderSuggestions(query) {
      if (!suggestionsBox) return;
      var q = normalize(query.trim());
      if (!q) { suggestionsBox.classList.add('hidden'); suggestionsBox.innerHTML = ''; return; }

      var matches = articles.filter(function (a) {
        return normalize(a.title).includes(q) || normalize(a.keywords).includes(q);
      });

      if (matches.length === 0) {
        suggestionsBox.innerHTML = '<div class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400">No se encontraron sugerencias</div>';
        suggestionsBox.classList.remove('hidden');
        return;
      }

      var html = matches.map(function (a) {
        return '<a href="' + a.href + '" class="block px-4 py-3 text-sm text-slate-700 dark:text-slate-200 hover:bg-emerald-50 dark:hover:bg-slate-700 transition-colors border-b border-slate-100 dark:border-slate-700 last:border-0">' +
          '<div class="font-medium">' + a.title + '</div>' +
          '<div class="text-xs text-slate-400 mt-0.5">' + a.keywords.split(' ').slice(0, 4).join(' · ') + '</div>' +
        '</a>';
      }).join('');
      suggestionsBox.innerHTML = html;
      suggestionsBox.classList.remove('hidden');
    }

    if (searchInput) {
      searchInput.addEventListener('input', function () { renderSuggestions(this.value); });
      searchInput.addEventListener('focus', function () { if (this.value.trim()) renderSuggestions(this.value); });
      searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          var q = normalize(this.value.trim());
          if (!q) return;
          var match = articles.find(function (a) { return normalize(a.title).includes(q) || normalize(a.keywords).includes(q); });
          if (match) window.location.href = match.href;
        }
      });
    }

    document.addEventListener('click', function (e) {
      if (searchInput && suggestionsBox && !searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
        suggestionsBox.classList.add('hidden');
      }
    });

    /* Keep the grid filtering for backwards compatibility */
    if (searchInput && articlesGrid) {
      searchInput.addEventListener('input', function () {
        var query = normalize(this.value.trim());
        var cards = articlesGrid.querySelectorAll('.article-card');
        var visibleCount = 0;
        cards.forEach(function (card) {
          var title = normalize(card.getAttribute('data-title') || '');
          var keywords = normalize(card.getAttribute('data-keywords') || '');
          var matches = !query || title.includes(query) || keywords.includes(query);
          card.style.display = matches ? '' : 'none';
          if (matches) visibleCount++;
        });
        if (emptyState) emptyState.classList.toggle('hidden', visibleCount > 0);
        articlesGrid.style.display = visibleCount === 0 ? 'none' : '';
      });
    }
  })();
</script>

<script>
  function initPageLogic() {
    // 1. Lógica del Buscador de artículos
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const articles = document.querySelectorAll('article, .article-card');

    if (searchInput && articles.length > 0) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        articles.forEach((article) => {
          const text = article.textContent?.toLowerCase() || '';
          if (text.includes(query)) {
            (article as HTMLElement).style.display = '';
          } else {
            (article as HTMLElement).style.display = 'none';
          }
        });
      });
    }

    // 2. Lógica de la Newsletter (MailerLite JSONP)
    const form = document.getElementById('newsletter-form') as HTMLFormElement;
    const message = document.getElementById('newsletter-message');
    const btn = document.getElementById('newsletter-btn') as HTMLButtonElement;
    const input = document.getElementById('newsletter-email') as HTMLInputElement;

    if (form && message && btn && input) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = input.value.trim();
        if (!email) return;

        btn.disabled = true;
        btn.textContent = 'Enviando...';

        const callbackName = 'ml_cb_' + Math.random().toString(36).substring(7);
        (window as any)[callbackName] = function() {
          delete (window as any)[callbackName];
        };

        const script = document.createElement('script');
        script.src = `https://assets.mailerlite.com/jsonp/2495707/forms/192351734327150216/subscribe?fields%5Bemail%5D=${encodeURIComponent(email)}&callback=${callbackName}`;

        document.body.appendChild(script);

        setTimeout(() => {
          form.classList.add('hidden');
          message.classList.remove('hidden');
          if (script.parentNode) script.parentNode.removeChild(script);
        }, 800);
      });
    }
  }

  initPageLogic();
  document.addEventListener('astro:page-load', initPageLogic);
</script>
