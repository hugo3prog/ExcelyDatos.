---
import '@/styles/globals.css';
import Layout from '../../layouts/Layout.astro';

const articles = [
  {
    title: 'Cómo sumar celdas en Excel: Guía rápida para principiantes (y el truco del teclado)',
    excerpt: 'Tres formas de sumar en Excel: la manual, la correcta y la rápida. Incluye el atajo Alt+= que todo el mundo debería conocer.',
    href: '/excel/como-sumar-celdas-en-excel/',
    readTime: '5 min',
    tag: 'Principiante',
    tagColor: 'bg-emerald-100 text-emerald-800',
  },
];
---

<Layout
  title="Excel & Google Sheets — Guías prácticas | ExcelyDatos"
  description="Aprende Excel y Google Sheets desde cero con guías claras y directas. Fórmulas, tablas dinámicas, macros VBA y Power Query explicados sin relleno."
>
  <!-- Hero silo -->
  <section class="bg-gradient-to-br from-emerald-700 to-emerald-900 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center">
          <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="11" height="11" rx="2" fill="white"/>
            <rect x="15" y="2" width="11" height="11" rx="2" fill="white" opacity="0.5"/>
            <rect x="2" y="15" width="11" height="11" rx="2" fill="white" opacity="0.5"/>
            <rect x="15" y="15" width="11" height="11" rx="2" fill="white" opacity="0.7"/>
          </svg>
        </div>
        <span class="text-emerald-300 font-semibold text-sm uppercase tracking-wider">Categoría</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Excel & Google Sheets</h1>
      <p class="text-emerald-100 text-lg max-w-2xl leading-relaxed">
        Todo lo que necesitas para dominar las hojas de cálculo en el trabajo real. Desde las fórmulas más básicas hasta automatizaciones con macros. Directo al punto, sin rodeos.
      </p>

      <!-- Topic pills -->
      <div class="flex flex-wrap gap-2 mt-8">
        {['Fórmulas', 'BUSCARV / XLOOKUP', 'Tablas dinámicas', 'Power Query', 'Macros VBA', 'Formato condicional', 'Gráficos', 'Google Sheets'].map(tag => (
          <span class="bg-white/10 text-emerald-100 text-xs font-medium px-3 py-1.5 rounded-full">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- AdSense leaderboard -->
    <div class="adsense-slot adsense-slot--leaderboard mb-10" aria-hidden="true">Espacio publicitario — 728×90</div>

    <div class="flex gap-10">
      <!-- Articles -->
      <div class="flex-1 min-w-0">
        <h2 class="text-xl font-bold text-[#1E293B] mb-6 flex items-center gap-2">
          <span class="w-1 h-5 bg-emerald-600 rounded-full inline-block"></span>
          Artículos publicados
        </h2>

        <div class="space-y-5">
          {articles.map((article) => (
            <article class="bg-white rounded-2xl border border-slate-200 hover:border-emerald-200 hover:shadow-md transition-all duration-200 p-6 flex gap-5">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-2">
                  <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${article.tagColor}`}>{article.tag}</span>
                  <span class="text-slate-400 text-xs">{article.readTime} de lectura</span>
                </div>
                <h3 class="font-bold text-[#1E293B] mb-2 leading-snug">
                  <a href={article.href} class="hover:text-emerald-700 transition-colors">{article.title}</a>
                </h3>
                <p class="text-slate-500 text-sm leading-relaxed">{article.excerpt}</p>
              </div>
              <div class="hidden sm:flex items-center">
                <a href={article.href} class="text-emerald-700 hover:text-emerald-900 transition-colors" aria-label="Leer artículo">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>

        <!-- Próximamente placeholder -->
        <div class="mt-8 bg-emerald-50 border border-dashed border-emerald-200 rounded-2xl p-8 text-center">
          <p class="text-emerald-700 font-semibold mb-1">Más guías en camino</p>
          <p class="text-emerald-600 text-sm">Nuevos artículos sobre XLOOKUP, tablas dinámicas y Power Query se publicarán próximamente.</p>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="hidden lg:block w-72 flex-shrink-0 space-y-6">
        <!-- Quick navigation -->
        <div class="bg-white rounded-2xl border border-slate-200 p-5">
          <h3 class="font-bold text-[#1E293B] text-sm mb-4">Otras categorías</h3>
          <div class="space-y-2">
            <a href="/powerbi/" class="flex items-center gap-2 text-sm text-amber-700 hover:text-amber-900 font-medium transition-colors py-1.5">
              <span class="w-2 h-2 bg-amber-400 rounded-full"></span>
              Power BI
            </a>
            <a href="/sql/" class="flex items-center gap-2 text-sm text-sky-700 hover:text-sky-900 font-medium transition-colors py-1.5">
              <span class="w-2 h-2 bg-sky-400 rounded-full"></span>
              SQL
            </a>
          </div>
        </div>

        <!-- AdSense sidebar -->
        <div class="adsense-slot adsense-slot--sidebar sticky top-24" aria-hidden="true">
          Espacio publicitario — Sidebar
        </div>
      </aside>
    </div>
  </div>
</Layout>
