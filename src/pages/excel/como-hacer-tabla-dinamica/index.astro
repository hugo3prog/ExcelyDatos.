import Layout from '../../../layouts/Layout.astro';

const title = 'Tabla dinámica en Excel y Sheets: guía paso a paso';
const description = 'Crea una tabla dinámica en Excel o Google Sheets: prepara los datos, arrastra campos, filtra y refresca. Con el atajo de teclado y un ejemplo de ventas.';
const publishDate = '2026-08-20';
const updateDate = '2026-07-07';
const readTime = '6 min';
const url = 'https://www.excelydatos.com/excel/como-hacer-tabla-dinamica/';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "datePublished": publishDate,
    "dateModified": updateDate,
    "author": { "@type": "Person", "name": "ExcelyDatos", "url": "https://www.excelydatos.com/autor/" },
    "publisher": {
      "@type": "Organization",
      "name": "ExcelyDatos",
      "url": "https://www.excelydatos.com"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": url
    },
    "image": "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1200&q=80"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.excelydatos.com/" },
      { "@type": "ListItem", "position": 2, "name": "Excel & Sheets", "item": "https://www.excelydatos.com/excel/" },
      { "@type": "ListItem", "position": 3, "name": "Cómo hacer una tabla dinámica", "item": url }
    ]
  }
];
---

<Layout title={`${title} — ExcelyDatos`} description={description} jsonLd={jsonLd} showReadingProgress={true}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- AdSense top -->

    <div class="flex gap-10">
      <!-- Article content -->
      <div class="min-w-0 flex-1">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-slate-400 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">Inicio</a>
          <span>/</span>
          <a href="/excel/" class="hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">Excel & Sheets</a>
          <span>/</span>
          <span class="text-slate-600 dark:text-slate-300 truncate">Cómo hacer una tabla dinámica</span>
        </nav>

        <!-- Header -->
        <header class="mb-8">
          <div class="flex items-center gap-2 mb-4">
            <span class="badge-excel">Excel</span>
            <span class="text-slate-400 text-sm">{readTime} de lectura</span>
            <span class="text-slate-300">·</span>
            <time class="text-slate-400 text-sm" datetime={updateDate}>Actualizado julio 2026</time>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-[#1E293B] dark:text-slate-100 leading-tight mb-5">
            {title}
          </h1>
          <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed border-l-4 border-emerald-500 pl-4">
            Tu jefe te manda una hoja de cálculo con 5.000 filas de ventas y quiere un resumen por región y producto para esta tarde. Podrías pelear con filtros, SUBTOTALES y un café, o puedes tirar una tabla dinámica en Excel o Google Sheets y tenerlo listo en cinco minutos. Vamos al lío.
          </p>
        </header>

        <!-- Cover image -->
        <div class="mb-10 rounded-2xl overflow-hidden shadow-sm">
          <img
            src="/tabla dinamica excel.png"
            alt="Tabla dinámica de Excel resumiendo datos de ventas"
            class="w-full max-h-[400px] object-cover"
            loading="eager"
            width="1200"
            height="400"
          />
        </div>

        <!-- AdSense rectangle in-article -->
        <div class="float-right ml-6 mb-6 hidden lg:block">
        </div>

        <div class="article-body">
          <h2>Un caso real: 5.000 filas y una pregunta para esta tarde</h2>
          <p>
            Tu jefe te pasa una hoja con cinco mil ventas y quiere saber qué producto lidera en cada región. Con filtros y sumas a mano te llevaría la tarde, y seguramente te equivocarías en algún subtotal. Una tabla dinámica responde a esa pregunta en unos clics.
          </p>
          <p>
            La hoja tiene las columnas <code>Fecha</code>, <code>Región</code>, <code>Producto</code>, <code>Vendedor</code> e <code>Importe</code>. Cada fila es una venta.
          </p>

          <h2>Paso 1: prepara los datos</h2>
          <p>
            Antes de insertar nada, los datos tienen que cumplir dos reglas, tanto en Excel como en Google Sheets:
          </p>
          <ul>
            <li><strong>Encabezados en la primera fila:</strong> cada columna necesita un título único. Sin encabezados, la tabla dinámica no sabe cómo llamar a los campos.</li>
            <li><strong>Sin filas vacías ni totales escritos a mano:</strong> borra las filas en blanco y los subtotales que alguien haya añadido. La tabla dinámica calcula los totales por sí sola, y si los dejas, el resultado sale inflado.</li>
          </ul>
          <p>
            En Excel, lo más rápido es convertir el rango en tabla: selecciona una celda con datos, ve a <strong>Insertar</strong> &gt; <strong>Tabla</strong> (o pulsa <code>Ctrl + T</code>) y confirma que "La tabla tiene encabezados" está marcado. En Google Sheets basta con que la primera fila tenga los títulos. Si añades filas nuevas a una tabla de Excel, la tabla dinámica las incluirá al actualizarla.
          </p>

          <img
            src="/Captura de pantalla 2026-07-25 120631.png"
            alt="Datos de ventas preparados como tabla en Excel"
            class="rounded-xl shadow-md border border-slate-200 block my-6"
            loading="lazy"
          />

          <h2>Paso 2: inserta la tabla dinámica</h2>
          <p>
            Selecciona una celda de tu tabla y ve a <strong>Insertar</strong> &gt; <strong>Tabla dinámica</strong>. Excel detecta el rango completo. En el diálogo, revisa dos cosas:
          </p>
          <ul>
            <li><strong>Rango:</strong> debe cubrir toda la tabla. Si la convertiste en tabla de Excel, verás algo como <code>Ventas[#Todos]</code>.</li>
            <li><strong>Ubicación:</strong> si es tu primera vez, elige "Nueva hoja de cálculo". Más adelante puedes colocarla en la misma hoja.</li>
          </ul>
          <p>
            Pulsa <strong>Aceptar</strong> y se abrirá el panel de campos a la derecha. En Google Sheets la ruta es la misma: <strong>Insertar</strong> &gt; <strong>Tabla dinámica</strong>.
          </p>

          <h2>Paso 3: arrastra los campos</h2>
          <p>
            El panel tiene cuatro áreas: <strong>Filtros</strong>, <strong>Columnas</strong>, <strong>Filas</strong> y <strong>Valores</strong>. El editor lateral de Google Sheets tiene las mismas cuatro secciones. Para responder a "qué producto vende más en cada región":
          </p>
          <ul>
            <li>Arrastra <code>Región</code> a <strong>Filas</strong>.</li>
            <li>Arrastra <code>Producto</code> a <strong>Columnas</strong>.</li>
            <li>Arrastra <code>Importe</code> a <strong>Valores</strong>.</li>
          </ul>
          <p>
            La tabla aparece al instante: cada fila es una región, cada columna un producto y cada celda suma los importes. ¿Quieres el promedio en lugar de la suma? En Excel, haz clic en el campo de valores del panel, abre <strong>Configuración del campo</strong> y cambia "Suma" por "Promedio", "Cuenta" o "Máximo". En Sheets, cambia el resumen de valores desde el editor.
          </p>

          <p>La configuración completa queda así:</p>
          <pre><code>Valores: Suma de Importe
Filas: Región
Columnas: Producto</code></pre>

          <img
            src="/Captura de pantalla 2026-07-25 121842.png"
            alt="Panel de campos de tabla dinámica con Región, Producto e Importe"
            class="rounded-xl shadow-md border border-slate-200 block my-6"
            loading="lazy"
          />

          <h2>Paso 4: filtra y ordena</h2>
          <p>
            Arrastra <code>Vendedor</code> a <strong>Filtros</strong>. Aparece un selector encima de la tabla que muestra solo las ventas de una persona. Si quieres marcar o desmarcar elementos concretos de una fila o columna, usa la flecha de su encabezado.
          </p>
          <p>
            Para ver de un vistazo qué región lidera, ordena de mayor a menor desde la flecha de la fila de totales (en Sheets, desde las opciones de ordenación del editor), y elige <strong>Ordenar de mayor a menor</strong>.
          </p>

          <h2>Paso 5: actualiza cuando cambien los datos</h2>
          <p>
            Excel y Google Sheets se comportan distinto. En Sheets, la tabla dinámica se actualiza sola en cuanto editas o añades datos en la fuente. En Excel, si añades ventas nuevas a la tabla original, la tabla dinámica no cambia hasta que la refrescas.
          </p>
          <p>
            Para refrescarla en Excel, haz clic derecho en cualquier celda de la tabla dinámica y elige <strong>Actualizar</strong>, o usa <strong>Actualizar todo</strong> en la pestaña <strong>Análisis de tabla dinámica</strong>.
          </p>

          <h2>Errores comunes</h2>
          <ul>
            <li><strong>"No se puede agrupar esa selección":</strong> suele aparecer cuando una columna de fechas tiene celdas vacías o texto mezclado. Limpia esas celdas y refresca.</li>
            <li><strong>Los totales no cuadran:</strong> busca filas con el importe en blanco o escrito como texto. Esos valores no suman como números, y el total no coincide con lo que esperas.</li>
            <li><strong>Excel no muestra los datos nuevos:</strong> en Excel hay que refrescar a mano. Clic derecho &gt; Actualizar, o el atajo de la sección Pro Tip.</li>
          </ul>

          <h2>Pro Tip</h2>
          <div class="bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl p-5 my-6 flex items-center gap-4">
            <div class="text-3xl font-mono font-bold text-emerald-700 dark:text-emerald-400">Alt + N + V</div>
            <div class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
              En Excel, con una celda de tu tabla seleccionada, pulsa <strong>Alt</strong>, luego <strong>N</strong> y luego <strong>V</strong> para abrir el diálogo de tabla dinámica sin tocar el ratón. Para refrescar todas las tablas dinámicas del libro, usa <strong>Alt + F5</strong>. En Google Sheets no necesitas atajos para esto.
            </div>
          </div>

          <p>
            Con esto tienes el flujo completo: preparar datos, insertar, configurar campos, filtrar y refrescar. Si el siguiente paso es llevar ese resumen a un cuadro de mando, la <a href="/powerbi/como-conectar-excel-con-power-bi/">guía de conexión de Excel con Power BI</a> explica cómo hacerlo.
          </p>
        </div>

