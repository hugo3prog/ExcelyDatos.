---
import '@/styles/globals.css';
import Layout from '../../layouts/Layout.astro';

const title = 'Herramientas gratuitas para analistas de datos — ExcelyDatos';
const description = 'Utilidades online y gratuitas para traducir fórmulas entre Excel y Google Sheets, generar BUSCARV paso a paso y descargar plantillas listas para usar. Sin registros ni instalaciones. Estamos trabajando en el desarrollo de más utilidades...';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Herramientas",
  "description": description,
  "url": "https://excelydatos.com/herramientas/"
};

const tools = [
  {
    title: 'Traductor de Fórmulas',
    subtitle: 'Excel ↔ Google Sheets',
    description: 'Convierte tus fórmulas entre Excel en español y Google Sheets en inglés (o viceversa) con un clic. Traduce nombres de funciones y separadores de argumentos automáticamente.',
    href: '/herramientas/traductor/',
    iconBg: 'bg-emerald-100 dark:bg-emerald-900/40',
    iconColor: 'text-emerald-600 dark:text-emerald-400',
    accent: 'emerald',
    icon: '<path d="M4 5h7M7 4v2c0 4-2 7-5 8"/><path d="M9 8c0 3 2 5 5 5"/><path d="M5 12h2c2 0 3 1 3 3v1M14 12h6M17 9v6"/>',
    badge: 'Gratis · Online'
  },
  {
    title: 'Generador de BUSCARV',
    subtitle: 'Paso a paso',
    description: 'No sabes cómo escribir un BUSCARV? Responde 4 preguntas y la herramienta genera la fórmula perfecta por ti, lista para copiar y pegar en tu hoja de cálculo.',
    href: '/herramientas/generador-buscarv/',
    iconBg: 'bg-sky-100 dark:bg-sky-900/40',
    iconColor: 'text-sky-600 dark:text-sky-400',
    accent: 'sky',
    icon: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
    badge: 'Gratis · Online'
  },
  {
    title: 'Galería de Plantillas',
    subtitle: 'Descargas gratuitas',
    description: 'Plantillas de Excel pre-diseñadas para tareas comunes: control de gastos, horario de empleados, CRM básico. Descárgalas gratis y empieza a trabajar ya.',
    href: '/herramientas/plantillas/',
    iconBg: 'bg-amber-100 dark:bg-amber-900/40',
    iconColor: 'text-amber-600 dark:text-amber-400',
    accent: 'amber',
    icon: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 3v18"/>',
    badge: 'Gratis · Descarga'
  },
  {
    title: 'Conversor de Excel a SQL',
    subtitle: 'INSERT automático',
    description: 'Pega los datos copiados de Excel o un CSV y genera sentencias INSERT INTO automáticamente. Detecta números y texto para poner comillas solo donde hace falta.',
    href: '/herramientas/excel-a-sql/',
    iconBg: 'bg-violet-100 dark:bg-violet-900/40',
    iconColor: 'text-violet-600 dark:text-violet-400',
    accent: 'violet',
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M10 12a2 2 0 0 0-2 2v3a2 2 0 1 0 4 0v-3a2 2 0 0 0-2-2zM10 12v-1a2 2 0 0 1 2-2"/>',
    badge: 'Gratis · Online'
  }
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="adsense-slot adsense-slot--leaderboard mb-8" aria-hidden="true"></div>

    <header class="mb-12 text-center max-w-2xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-bold text-[#1E293B] dark:text-slate-100 mb-4">Herramientas</h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Utilidades online y gratuitas para analistas de datos. Sin instalaciones, sin registros. Traduce fórmulas, genera BUSCARV sin saber Excel y descarga plantillas listas para usar.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class="group bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col"
        >
          <div class={`w-14 h-14 ${tool.iconBg} rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300`}>
            <svg class={`w-7 h-7 ${tool.iconColor}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={tool.icon} />
          </div>
          <div class="flex items-center gap-2 mb-2">
            <h2 class="text-xl font-bold text-[#1E293B] dark:text-slate-100">{tool.title}</h2>
          </div>
          <p class="text-sm font-medium text-slate-400 mb-3">{tool.subtitle}</p>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed flex-grow">{tool.description}</p>
          <div class="mt-5 flex items-center justify-between">
            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30 px-3 py-1 rounded-full">{tool.badge}</span>
            <span class={`text-sm font-semibold text-${tool.accent}-600 dark:text-${tool.accent}-400 group-hover:translate-x-1 transition-transform duration-200`}>
              Abrir →
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="adsense-slot adsense-slot--leaderboard mt-12" aria-hidden="true"></div>
  </div>
</Layout>
