---
import '@/styles/globals.css';
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Contacto — ExcelyDatos"
  description="¿Tienes una pregunta, sugerencia o quieres proponer un tema? Escríbenos. Respondemos todos los mensajes relacionados con el contenido del sitio."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-slate-700 to-[#1E293B] text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
      <nav class="flex items-center gap-2 text-sm text-slate-400 mb-8" aria-label="Ruta de navegación">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-200">Contacto</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Contacto</h1>
      <p class="text-slate-300 text-lg max-w-2xl leading-relaxed">
        Escríbenos si tienes una duda sobre algún artículo, una sugerencia de tema o cualquier consulta relacionada con el sitio.
      </p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

      <!-- Form -->
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Envíanos un mensaje</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm mb-8">
          Respondemos todos los mensajes en un plazo de 2 a 5 días hábiles. Por favor, sé lo más específico posible en tu consulta para que podamos ayudarte mejor.
        </p>

        <form
          id="contact-form"
          class="space-y-6"
          novalidate
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-[#1E293B] mb-1.5">
                Nombre <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Tu nombre"
                class="w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-[#1E293B] mb-1.5">
                Correo electrónico <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="tucorreo@ejemplo.com"
                class="w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-[#1E293B] mb-1.5">
              Asunto <span class="text-red-500" aria-hidden="true">*</span>
            </label>
            <select
              id="subject"
              name="subject"
              required
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition"
            >
              <option value="" disabled selected>Selecciona un tipo de consulta</option>
              <option value="duda-contenido">Duda sobre un artículo publicado</option>
              <option value="sugerencia-tema">Sugerencia de nuevo tema o guía</option>
              <option value="error-contenido">He encontrado un error en el contenido</option>
              <option value="publicidad">Consulta sobre publicidad o colaboraciones</option>
              <option value="privacidad">Ejercicio de derechos sobre datos personales</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-[#1E293B] mb-1.5">
              Mensaje <span class="text-red-500" aria-hidden="true">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              placeholder="Describe tu consulta con el mayor detalle posible. Si tienes un error en Excel o SQL, incluye la fórmula o consulta exacta y el resultado que estás obteniendo."
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition resize-none"
            ></textarea>
          </div>

          <!-- Privacy consent -->
          <div class="flex items-start gap-3">
            <input
              id="privacy"
              name="privacy"
              type="checkbox"
              required
              class="mt-0.5 w-4 h-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer"
            />
            <label for="privacy" class="text-sm text-slate-600 leading-relaxed cursor-pointer">
              He leído y acepto la <a href="/privacidad/" class="text-emerald-700 underline hover:text-emerald-900">Política de Privacidad</a>. Entiendo que mis datos serán usados únicamente para responder a mi consulta.
            </label>
          </div>

          <!-- Status messages -->
          <div id="form-success" class="hidden bg-emerald-50 border border-emerald-300 text-emerald-800 rounded-lg px-4 py-3 text-sm font-medium">
            Mensaje enviado correctamente. Te responderemos en los próximos días hábiles.
          </div>
          <div id="form-error" class="hidden bg-red-50 border border-red-300 text-red-800 rounded-lg px-4 py-3 text-sm font-medium">
            Ha ocurrido un error al enviar el mensaje. Por favor, revisa los campos e inténtalo de nuevo.
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="inline-flex items-center justify-center gap-2 bg-emerald-700 hover:bg-emerald-800 disabled:bg-emerald-400 text-white font-semibold px-6 py-3 rounded-lg text-sm transition-colors duration-200 w-full sm:w-auto"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
            Enviar mensaje
          </button>
        </form>
      </div>

      <!-- Sidebar info -->
      <aside class="space-y-6">
        <!-- What we respond to -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
          <h3 class="font-bold text-slate-900 dark:text-slate-100 mb-4 text-base">Qué tipo de consultas respondemos</h3>
          <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-400">
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 mt-0.5 flex-shrink-0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              Dudas sobre artículos publicados en el sitio
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 mt-0.5 flex-shrink-0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              Sugerencias de temas o guías nuevas
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 mt-0.5 flex-shrink-0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              Errores detectados en el contenido
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 mt-0.5 flex-shrink-0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              Ejercicio de derechos sobre datos personales
            </li>
          </ul>
        </div>

        <!-- What we don't respond to -->
        <div class="bg-slate-50 dark:bg-slate-800/60 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
          <h3 class="font-bold text-slate-900 dark:text-slate-100 mb-4 text-base">Lo que no podemos hacer</h3>
          <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-400">
            <li class="flex items-start gap-2">
              <span class="text-slate-400 mt-0.5 flex-shrink-0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </span>
              Resolver problemas de Excel o SQL específicos de tu empresa (no es un servicio de soporte técnico)
            </li>
            <li class="flex items-start gap-2">
              <span class="text-slate-400 mt-0.5 flex-shrink-0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </span>
              Publicar artículos de pago o patrocinados sin indicarlo
            </li>
            <li class="flex items-start gap-2">
              <span class="text-slate-400 mt-0.5 flex-shrink-0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </span>
              Intercambios de enlaces o colaboraciones de SEO no editoriales
            </li>
          </ul>
        </div>

        <!-- Response time -->
        <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-5 flex items-start gap-3">
          <svg class="text-emerald-600 flex-shrink-0 mt-0.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          <div>
            <p class="text-emerald-800 font-semibold text-sm">Tiempo de respuesta</p>
            <p class="text-emerald-700 text-sm mt-1">Respondemos en un plazo de 2 a 5 días hábiles. En temporadas de alta demanda puede tardar algo más.</p>
          </div>
        </div>

        <!-- Privacy note -->
        <div class="text-xs text-slate-400 leading-relaxed">
          Los datos que nos envíes a través de este formulario se utilizarán exclusivamente para atender tu consulta. Consulta nuestra <a href="/privacidad/" class="text-emerald-600 hover:text-emerald-800 underline">Política de Privacidad</a> para más información.
        </div>
      </aside>
    </div>

    <!-- ===== REDES SOCIALES ===== -->
    <div class="mt-16 pt-12 border-t border-slate-200 dark:border-slate-700">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-2">Nuestras Redes Sociales</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm">Síguenos para contenido sobre Excel, Power BI y SQL.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl">

        <!-- Instagram -->
        <a
          href="#"
          aria-label="Síguenos en Instagram"
          class="group relative overflow-hidden rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
          style="background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);"
        >
          <div class="absolute inset-0 opacity-0 group-hover:opacity-10 bg-white transition-opacity duration-300"></div>
          <div class="relative flex items-start gap-4">
            <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-white font-bold text-lg leading-tight">Instagram</p>
              <p class="text-white/80 text-sm mt-1 leading-relaxed">Síguenos para contenido sobre Excel, Power BI y SQL.</p>
              <span class="inline-flex items-center gap-1 text-white/90 text-xs font-semibold mt-3">
                Seguir
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </div>
        </a>

        <!-- TikTok -->
        <a
          href="#"
          aria-label="Síguenos en TikTok"
          class="group relative overflow-hidden rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl bg-[#010101]"
        >
          <!-- TikTok neon accent -->
          <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-[#69C9D0] via-[#EE1D52] to-[#69C9D0]"></div>
          <div class="absolute inset-0 opacity-0 group-hover:opacity-5 bg-white transition-opacity duration-300"></div>
          <div class="relative flex items-start gap-4">
            <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="white">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.86 4.86 0 0 1-1.01-.06z"/>
              </svg>
            </div>
            <div class="flex-1">
              <p class="text-white font-bold text-lg leading-tight">TikTok</p>
              <p class="text-white/70 text-sm mt-1 leading-relaxed">Aprende Excel en menos de 60 segundos con nuestros vídeos cortos y directos al grano.</p>
              <span class="inline-flex items-center gap-1 text-[#69C9D0] text-xs font-semibold mt-3">
                Seguir
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </div>
        </a>

      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';
    }

    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    // Simulate form submission (replace with real endpoint when ready)
    await new Promise((resolve) => setTimeout(resolve, 1000));

    successMsg?.classList.remove('hidden');
    form.reset();

    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
        Enviar mensaje
      `;
    }
  });
</script>
