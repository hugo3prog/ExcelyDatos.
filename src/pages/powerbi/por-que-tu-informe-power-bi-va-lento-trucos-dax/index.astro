const title = 'Por qué tu informe de Power BI va lento: 3 trucos con DAX para acelerar el rendimiento';
const description = 'Descubre por qué tu informe de Power BI es lento y aprende 3 trucos prácticos con DAX para optimizar el rendimiento: medidas en lugar de columnas calculadas, uso correcto de CALCULATE y variables. Paso a paso.';
const publishDate = '2025-11-15';
const updateDate = '2026-11-15';
const readTime = '7 min';
const url = 'https://excelydatos.com/powerbi/por-que-tu-informe-power-bi-va-lento-trucos-dax/';

const jsonLd = [
  { "@context": "https://schema.org", "@type": "Article", "headline": title, "description": description, "datePublished": publishDate, "dateModified": updateDate, "author": { "@type": "Organization", "name": "ExcelyDatos", "url": "https://excelydatos.com" }, "publisher": { "@type": "Organization", "name": "ExcelyDatos", "url": "https://excelydatos.com" }, "mainEntityOfPage": { "@type": "WebPage", "@id": url } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://excelydatos.com/" }, { "@type": "ListItem", "position": 2, "name": "Power BI", "item": "https://excelydatos.com/powerbi/" }, { "@type": "ListItem", "position": 3, "name": "Por qué tu informe va lento", "item": url } ] }
];
---

<Layout title={`${title} — ExcelyDatos`} description={description} jsonLd={jsonLd} showReadingProgress={true}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="adsense-slot adsense-slot--leaderboard mb-8" aria-hidden="true"></div>
