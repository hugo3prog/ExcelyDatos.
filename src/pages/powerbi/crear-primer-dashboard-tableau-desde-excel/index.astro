import Layout from '../../../layouts/Layout.astro';

const title = 'Cómo crear tu primer Dashboard en Tableau Desktop desde un Excel (Paso a paso)';
const description = 'Conecta tus hojas de cálculo a Tableau Desktop, crea tus primeras hojas de trabajo interactivas y móntalas en un panel listo para presentar a tu equipo.';
const publishDate = '2026-09-27';
const updateDate = '2026-11-11';
const readTime = '8 min';
const url = 'https://www.excelydatos.com/powerbi/crear-primer-dashboard-tableau-desde-excel/';

const jsonLd = [
  { "@context": "https://schema.org", "@type": "Article", "headline": title, "description": description, "datePublished": publishDate, "dateModified": updateDate, "author": { "@type": "Person", "name": "ExcelyDatos", "url": "https://www.excelydatos.com/autor/" }, "publisher": { "@type": "Organization", "name": "ExcelyDatos", "url": "https://www.excelydatos.com" }, "mainEntityOfPage": { "@type": "WebPage", "@id": url } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.excelydatos.com/" }, { "@type": "ListItem", "position": 2, "name": "Power BI & Tableau", "item": "https://www.excelydatos.com/powerbi/" }, { "@type": "ListItem", "position": 3, "name": "Primer Dashboard en Tableau", "item": url } ] },
  { "@context": "https://schema.org", "@type": "HowTo", "name": "Crear un dashboard en Tableau Desktop desde Excel", "step": [
    { "@type": "HowToStep", "position": 1, "name": "Conectar el archivo de Excel", "text": "Abre Tableau Desktop, selecciona Microsoft Excel en el panel de conexiones y elige tu archivo .xlsx. Tableau detecta automáticamente las hojas y tablas del libro." },
    { "@type": "HowToStep", "position": 2, "name": "Crear un gráfico de barras", "text": "Arrastra la dimensión Categoría al estante de Filas y la medida Ventas al estante de Columnas. Tableau genera automáticamente un gráfico de barras con las ventas por categoría." },
    { "@type": "HowToStep", "position": 3, "name": "Crear un gráfico de líneas", "text": "Crea una nueva hoja de trabajo, arrastra el campo Fecha al estante de Columnas y Ventas al de Filas. Tableau crea un gráfico de líneas mostrando la evolución temporal." },
    { "@type": "HowToStep", "position": 4, "name": "Montar el dashboard", "text": "Crea un nuevo dashboard, arrastra las dos hojas de trabajo al lienzo y ajústalas para que se vean ambas visualizaciones en el mismo panel." },
    { "@type": "HowToStep", "position": 5, "name": "Aplicar filtro de acciones", "text": "Usa Filtros en el menú del dashboard para que al hacer clic en una barra del gráfico de categorías, el gráfico de líneas se actualice mostrando solo los datos de esa categoría." }
  ] }
];
---

<Layout title={`${title} — ExcelyDatos`} description={description} jsonLd={jsonLd} showReadingProgress={true}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex gap-10">
      <div class="min-w-0 flex-1">
        <nav class="flex items-center gap-2 text-sm text-slate-400 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-slate-600 dark:hover:text-slate-300 transition-colors">Inicio</a><span>/</span>
          <a href="/powerbi/" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Power BI & Tableau</a><span>/</span>
          <span class="text-slate-600 dark:text-slate-300 truncate">Primer Dashboard en Tableau</span>
        </nav>
        <header class="mb-8">
          <div class="flex items-center gap-2 mb-4">
            <span class="badge-powerbi">Power BI & Tableau</span><span class="text-slate-400 text-sm">{readTime} de lectura</span><span class="text-slate-300">·</span>
            <time class="text-slate-400 text-sm" datetime={updateDate}>Actualizado noviembre 2026</time>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-[#1E293B] dark:text-slate-100 leading-tight mb-5">{title}</h1>
          <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed border-l-4 border-amber-500 pl-4">
            Conecta tus hojas de cálculo a Tableau Desktop, crea tus primeras hojas de trabajo interactivas y móntalas en un panel listo para presentar a tu equipo.
          </p>
        </header>
        <div class="mb-10 rounded-2xl overflow-hidden shadow-sm">
          <img src="/Guía visual_ de Excel a Tableau (2).png" alt="Guía visual para crear un dashboard en Tableau a partir de un archivo Excel" class="w-full h-auto object-contain" loading="eager" width="1200" height="400" />
        </div>
        <div class="float-right ml-6 mb-6 hidden lg:block"></div>
        <div class="article-body">
          <h2>La interfaz de Tableau Desktop: Hojas de Trabajo vs Dashboards</h2>
          <p>Antes de tocar nada, tienes que entender cómo organiza Tableau tu trabajo. A diferencia de Excel, donde todo vive en una misma hoja, Tableau separa tres conceptos que se relacionan entre sí:</p>
          <ul class="list-disc pl-6 space-y-3 text-slate-700 dark:text-slate-300">
            <li><strong>Hoja de Trabajo (Worksheet):</strong> es donde creas una visualización individual. Un gráfico de barras, un gráfico de líneas o un mapa. Cada hoja tiene su propia pestaña en la parte inferior, como las pestañas de Excel.</li>
            <li><strong>Dashboard:</strong> es el panel donde combinas varias hojas de trabajo en un solo lienzo. Es lo que vas a mostrar a tu equipo o a tu jefe.</li>
            <li><strong>Historia (Story):</strong> una secuencia de dashboards o hojas que cuentan una narrativa paso a paso, como una presentación. No la vamos a usar en este tutorial.</li>
          </ul>
          <p>El flujo es siempre el mismo: creas hojas de trabajo individuales y luego las montas en un dashboard. Es como cocinar los ingredientes por separado antes de emplatarlos.</p>

          <h2>Paso 1: Conectar el archivo de Excel y preparar el origen de datos</h2>
          <p>Abre Tableau Desktop. La pantalla de inicio muestra los conectores disponibles a la izquierda, agrupados por tipo. Busca <strong>Microsoft Excel</strong> en la sección "Para un archivo" y haz clic.</p>
          <p>Se abre el explorador de archivos. Navega hasta tu archivo .xlsx y selecciónalo. Tableau detecta automáticamente todas las hojas y tablas que contiene el libro y te las muestra en el panel izquierdo. Arrastra la hoja que quieres analizar al área central, donde dice "Arrastrar las tablas aquí".</p>
          <p>Tableau clasifica tus columnas en dos tipos: <strong>Dimensiones</strong> (categorías, textos, fechas) y <strong>Medidas</strong> (números que se pueden sumar o promediar). Si alguna columna está mal clasificada, haz clic en su icono y cámbiala. Por ejemplo, el ID de un producto es un número pero debería ser una Dimensión, no una Medida.</p>
          <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700/50 rounded-xl p-4 my-6">
            <p class="text-amber-900 dark:text-amber-300 text-sm font-medium mb-1">Antes de seguir</p>
            <p class="text-amber-800 dark:text-amber-400 text-sm">Tu Excel debe tener la primera fila como encabezados y sin filas vacías arriba. Tableau es estricto con esto. Si tu archivo tiene títulos decorativos en las primeras filas, limpia el Excel primero.</p>
          </div>

          <h2>Paso 2: Crear un gráfico de barras (Ventas por Categoría)</h2>
          <p>Ya tienes los datos cargados. Haz clic en <strong>Nueva hoja de trabajo</strong> en la parte inferior (el icono de la hoja en blanco). Verás la zona de trabajo: a la izquierda tus campos organizados en Dimensiones y Medidas, y en el centro los estantes de Filas y Columnas.</p>
          <p>Para crear un gráfico de barras de ventas por categoría:</p>
          <ol class="list-decimal pl-6 space-y-3 text-slate-700 dark:text-slate-300">
            <li>Arrastra la dimensión <strong>Categoría</strong> al estante de <strong>Columnas</strong>. Verás aparecer las categorías en el eje horizontal.</li>
            <li>Arrastra la medida <strong>Ventas</strong> al estante de <strong>Filas</strong>. Tableau genera automáticamente un gráfico de barras con las ventas totales de cada categoría.</li>
          </ol>
          <p>Así de fácil. Tableau eligió el gráfico de barras por defecto porque es el más adecuado para comparar categorías. Si quieres cambiarlo, tienes el panel <strong>Marcas</strong> donde puedes modificar color, tamaño, forma y tipo de gráfico.</p>
          <p>Renombra la hoja haciendo doble clic en su pestaña inferior y poniéndole "Ventas por Categoría". Es importante poner nombres descriptivos porque luego vas a montar el dashboard y necesitarás identificar cada hoja.</p>

          <h2>Paso 3: Crear un gráfico de líneas (Evolución temporal)</h2>
          <p>Crea otra hoja de trabajo nueva. Esta vez vamos a mostrar cómo evolucionan las ventas a lo largo del tiempo:</p>
          <ol class="list-decimal pl-6 space-y-3 text-slate-700 dark:text-slate-300">
            <li>Arrastra la dimensión <strong>Fecha</strong> al estate de <strong>Columnas</strong>. Tableau la reconoce como fecha y crea un eje temporal automático.</li>
            <li>Arrastra la medida <strong>Ventas</strong> al estante de <strong>Filas</strong>. Aparece un gráfico de líneas mostrando la evolución de ventas mes a mes.</li>
          </ol>
          <p>Si el eje temporal muestra más detalle del que necesitas (por ejemplo, días en lugar de meses), haz clic en la píldora de Fecha en el estante de Columnas y cambia el nivel de detalle. Puedes elegir Año, Trimestre, Mes o Día según lo que quieras mostrar.</p>
          <p>Renombra esta hoja como "Evolución de Ventas". Ya tienes tus dos ingredientes listos: un gráfico de barras y un gráfico de líneas. Ahora vamos a emplatarlos.</p>

          <h2>Paso 4: Combinar ambos gráficos en un objeto Dashboard</h2>
          <p>Haz clic en <strong>Nuevo Dashboard</strong> en la parte inferior (el icono con dos cuadrados superpuestos). Verás un lienzo en blanco y, a la izquierda, una lista de las hojas de trabajo que has creado.</p>
          <p>El dashboard funciona por arrastre:</p>
          <ol class="list-decimal pl-6 space-y-3 text-slate-700 dark:text-slate-300">
            <li>Arrastra "Ventas por Categoría" al lienzo. Ocupará la parte superior del dashboard.</li>
            <li>Arrastra "Evolución de Ventas" debajo. Tableau ajusta automáticamente el tamaño para que ambas visualizaciones encajen.</li>
          </ol>
          <p>Puedes redimensionar cada elemento arrastrando los bordes. También puedes añadir un título al dashboard haciendo clic en el texto "Dashboard 1" en la parte superior y escribiendo algo más descriptivo, como "Panel de Ventas 2026".</p>
          <p>En la parte izquierda tienes opciones para ajustar el tamaño del dashboard. Si lo vas a presentar en una pantalla, elige "Pantalla de ordenador" y Tableau adaptará todo para que se vea bien en una resolución estándar.</p>

          <h2>Paso 5: Aplicar un filtro de acciones para que todo se actualice</h2>
          <p>El dashboard ya se ve bien, pero todavía no es interactivo. Vamos a hacer que al hacer clic en una barra del gráfico de categorías, el gráfico de líneas se filtre solo mostrando esa categoría.</p>
          <ol class="list-decimal pl-6 space-y-3 text-slate-700 dark:text-slate-300">
            <li>En el dashboard, selecciona el gráfico "Ventas por Categoría". Aparece una pequeña flecha en la esquina superior derecha de la visualización.</li>
            <li>Haz clic en esa flecha y selecciona <strong>Usar como filtro</strong>.</li>
            <li>Listo. Ahora haz clic en cualquier barra del gráfico de categorías y verás cómo el gráfico de líneas se actualiza automáticamente mostrando solo la evolución temporal de esa categoría.</li>
          </ol>
          <p>Para quitar el filtro, simplemente vuelve a hacer clic en la barra seleccionada. Es la interactividad más básica de Tableau y la que más impacta en una presentación: tu jefe puede explorar los datos sin que tengas que crear un gráfico nuevo cada vez.</p>
          <p>Si quieres un control más fino, en el menú <strong>Dashboard &rarr; Acciones</strong> puedes definir filtros específicos entre hojas, resaltar elementos relacionados o navegar entre dashboards. Pero para tu primer panel, el "Usar como filtro" es suficiente.</p>

          <h2>Errores de principiante al diseñar cuadros de mando en Tableau</h2>
          <ul class="list-disc pl-6 space-y-3 text-slate-700 dark:text-slate-300">
            <li><strong>Poner demasiados gráficos en un solo dashboard:</strong> cinco visualizaciones claras son mejor que doce que nadie entiende. Menos es más, sobre todo cuando presentas a personas que no trabajan con datos a diario.</li>
            <li><strong>No nombrar las hojas de trabajo:</strong> cuando tienes cinco hojas llamadas "Hoja 1", "Hoja 2" y "Hoja 3", montar el dashboard se convierte en un caos. Pon nombres descriptivos desde el principio.</li>
            <li><strong>Olvidar ajustar el tamaño del dashboard:</strong> si lo dejas en tamaño automático, puede verse deformado en pantallas distintas. Define un tamaño fijo adecuado a tu presentación.</li>
            <li><strong>No formatear las visualizaciones:</strong> Tableau aplica colores por defecto que son correctos pero algo planos. Dedica cinco minutos a ajustar colores, etiquetas y tipografía. La diferencia visual es enorme.</li>
            <li><strong>Mezclar escalas incompatibles:</strong> si pones ventas en euros y número de pedidos en el mismo gráfico de barras, las barras de pedidos se verán minúsculas frente a las de ventas. Usa ejes duales o separa los gráficos.</li>
          </ul>

          <div class="my-8 rounded-2xl border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950/30 p-5">
            <p class="text-amber-800 dark:text-amber-200 font-semibold mb-2">Pro Tip</p>
            <p class="text-slate-700 dark:text-slate-300 leading-relaxed">Tableau tiene un repositorio de dashboards públicos llamado Tableau Public. Búscalo y explora lo que otros analistas publican. Es la mejor forma de inspirarte y aprender trucos de diseño que no se encuentran en la documentación oficial.</p>
          </div>
        </div>
        <div class="mt-10 mb-6">
          <p class="text-sm font-semibold text-slate-500 dark:text-slate-400 mb-3">Compartir este artículo</p>
